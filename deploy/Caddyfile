# Caddy reverse proxy for the EYL dashboard.
#
# - Set DASHBOARD_DOMAIN (in .env.local) to a real hostname and Caddy will
#   provision + renew a Let's Encrypt cert automatically over 443.
# - Left at the default "localhost", Caddy serves a local self-signed cert
#   so you can test the proxy path without a public domain.

{$DASHBOARD_DOMAIN:localhost} {
	encode gzip zstd

	# Security headers at the edge (mirrors next.config.mjs; adds HSTS, which
	# should only be sent over real HTTPS).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	reverse_proxy dashboard:3000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}
}
